<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Камера PiSun</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

body {
    background: #0d1117;
    color: #e6edf3;
    font-family: Arial, Helvetica, sans-serif;
}

.app {
    width: 100%;
    height: 100vh;
    padding: 14px;
    display: flex;
    flex-direction: column;
}

/* HEADER */

.header {
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    margin-bottom: 12px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #202832;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
}

.title {
    font-size: 25px;
    font-weight: 700;
}

.subtitle {
    color: #8b949e;
    font-size: 13px;
    margin-top: 3px;
}

.status {
    text-align: right;
    color: #8b949e;
    font-size: 13px;
}

.online {
    color: #3fb950;
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 4px;
}

/* MAIN */

.main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 14px;
}

/* VIDEO */

.video-section {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.video-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    background: #000;
    border: 2px solid #303944;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,.35);
}

.video-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
}

.camera-label {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(13,17,23,.85);
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 14px;
    z-index: 5;
}

.fullscreen {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 9px;
    background: rgba(13,17,23,.85);
    color: white;
    font-size: 20px;
    cursor: pointer;
}

/* CAMERA SELECT */

.camera-select {
    height: 55px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
}

.camera-btn {
    height: 44px;
    padding: 0 25px;
    border: 1px solid #3a4653;
    border-radius: 9px;
    background: #1b222c;
    color: #e6edf3;
    font-size: 15px;
    cursor: pointer;
}

.camera-btn:hover {
    background: #252e39;
}

.camera-btn.active {
    background: #1769aa;
    border-color: #2389d7;
}

/* CONTROL PANEL */

.control-panel {
    background: #141a21;
    border: 2px solid #303944;
    border-radius: 14px;
    padding: 18px;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.control-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 15px;
}

.section {
    border-top: 1px solid #303944;
    padding-top: 14px;
    margin-top: 5px;
}

.section-title {
    color: #c9d1d9;
    font-size: 14px;
    margin-bottom: 10px;
}

/* DIRECTION */

.direction {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 7px;
    width: 230px;
    margin: 0 auto;
}

.control-btn {
    height: 46px;
    border: 1px solid #3b4652;
    border-radius: 8px;
    background: #202832;
    color: #f0f6fc;
    font-size: 22px;
    cursor: pointer;
    transition: .1s;
}

.control-btn:hover {
    background: #2b3541;
}

.control-btn:active {
    background: #1769aa;
    transform: scale(.96);
}

.center-btn {
    font-size: 16px;
}

/* ZOOM */

.zoom {
    display: grid;
    grid-template-columns: 1fr 70px 1fr;
    gap: 8px;
    align-items: center;
}

.zoom-value {
    text-align: center;
    color: #c9d1d9;
    font-size: 15px;
}

/* SETTINGS */

.settings {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 7px;
}

.settings button {
    height: 42px;
    padding: 4px;
    font-size: 12px;
}

/* FOOTER */

.footer {
    height: 24px;
    text-align: center;
    color: #6e7681;
    font-size: 11px;
    padding-top: 5px;
}

/* SMALL SCREENS */

@media (max-width: 850px) {
    html, body {
        overflow: auto;
    }

    .app {
        height: auto;
        min-height: 100vh;
    }

    .main {
        grid-template-columns: 1fr;
    }

    .video-frame {
        aspect-ratio: 16 / 9;
        height: auto;
    }

    .control-panel {
        height: auto;
    }
}
</style>
</head>

<body>

<div class="app">

    <div class="header">

        <div class="logo">
            <div class="logo-icon">📷</div>
            <div>
                <div class="title">Камера PiSun</div>
                <div class="subtitle">Відеоспостереження та керування</div>
            </div>
        </div>

        <div class="status">
            <div class="online">● Онлайн</div>
            <div>FPS: 20 &nbsp;|&nbsp; 1280×720</div>
        </div>

    </div>


    <div class="main">

        <!-- VIDEO -->

        <div class="video-section">

            <div class="video-frame" id="videoFrame">

                <div class="camera-label" id="cameraLabel">
                    📷 Основна камера
                </div>

                <iframe
                    id="video"
                    src="http://pisun.local:8889/cam/"
                    allow="autoplay; fullscreen">
                </iframe>

                <button class="fullscreen" onclick="fullscreenVideo()">
                    ⛶
                </button>

            </div>


            <div class="camera-select">

                <button
                    id="mainCameraBtn"
                    class="camera-btn active"
                    onclick="selectCamera('main')">
                    📷 Основна камера
                </button>

                <button
                    id="thermalCameraBtn"
                    class="camera-btn"
                    onclick="selectCamera('thermal')">
                    🔥 Тепловізійна
                </button>

            </div>

        </div>


        <!-- CONTROL PANEL -->

        <div class="control-panel">

            <div class="control-title">
                🎯 Керування камерою
            </div>


            <div class="section">

                <div class="section-title">
                    Напрямок
                </div>

                <div class="direction">

                    <div></div>

                    <button
                        class="control-btn"
                        onclick="cameraCommand('up')">
                        ▲
                    </button>

                    <div></div>


                    <button
                        class="control-btn"
                        onclick="cameraCommand('left')">
                        ◀
                    </button>

                    <button
                        class="control-btn center-btn"
                        onclick="cameraCommand('center')">
                        ●
                    </button>

                    <button
                        class="control-btn"
                        onclick="cameraCommand('right')">
                        ▶
                    </button>


                    <div></div>

                    <button
                        class="control-btn"
                        onclick="cameraCommand('down')">
                        ▼
                    </button>

                    <div></div>

                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    Зум
                </div>

                <div class="zoom">

                    <button
                        class="control-btn"
                        onclick="zoom(-1)">
                        −
                    </button>

                    <div
                        class="zoom-value"
                        id="zoomValue">
                        1.0x
                    </div>

                    <button
                        class="control-btn"
                        onclick="zoom(1)">
                        +
                    </button>

                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    Налаштування
                </div>

                <div class="settings">

                    <button
                        class="control-btn"
                        onclick="cameraCommand('center')">
                        🏠<br>На центр
                    </button>

                    <button
                        class="control-btn"
                        onclick="cameraCommand('reset')">
                        ↻<br>Скинути
                    </button>

                    <button
                        class="control-btn"
                        onclick="cameraCommand('lock')">
                        🔒<br>Зафіксувати
                    </button>

                </div>

            </div>

        </div>

    </div>


    <div class="footer">
        PiSun • Raspberry Pi Zero 2 W
    </div>

</div>


<script>

let currentCamera = "main";
let currentZoom = 1.0;


function selectCamera(camera) {

    const video = document.getElementById("video");
    const label = document.getElementById("cameraLabel");

    const mainBtn = document.getElementById("mainCameraBtn");
    const thermalBtn = document.getElementById("thermalCameraBtn");


    if (camera === "main") {

        currentCamera = "main";

        video.src = "http://pisun.local:8889/cam/";

        label.innerHTML = "📷 Основна камера";

        mainBtn.classList.add("active");
        thermalBtn.classList.remove("active");

    }


    if (camera === "thermal") {

        currentCamera = "thermal";

        /*
         * Тепловізор підключимо сюди пізніше.
         * Очікуваний MediaMTX path: /thermal
         */

        video.src = "http://pisun.local:8090/thermal";

        label.innerHTML = "🔥 Тепловізійна";

        thermalBtn.classList.add("active");
        mainBtn.classList.remove("active");

    }

}


function cameraCommand(command) {
    const step = 50;

    if (typeof window.servoX === "undefined") window.servoX = 1500;
    if (typeof window.servoY === "undefined") window.servoY = 1500;

    if (command === "left")  window.servoX -= step;
    if (command === "right") window.servoX += step;
    if (command === "up")    window.servoY += step;
    if (command === "down")  window.servoY -= step;

    if (command === "center" || command === "reset") {
        window.servoX = 1500;
        window.servoY = 1500;
    }

    window.servoX = Math.max(1000, Math.min(2000, window.servoX));
    window.servoY = Math.max(1000, Math.min(2000, window.servoY));

    if (command === "left" || command === "right" || command === "center" || command === "reset") {
        fetch(`/api/servo?gpio=18&us=${window.servoX}`);
    }

    if (command === "up" || command === "down" || command === "center" || command === "reset") {
        fetch(`/api/servo?gpio=19&us=${window.servoY}`);
    }

    console.log("Servo X:", window.servoX, "Servo Y:", window.servoY);
}


function zoom(direction) {
    if (direction > 0) {
        currentZoom = Math.min(4.0, currentZoom + 0.5);
    } else {
        currentZoom = Math.max(1.0, currentZoom - 0.5);
    }

    const video = document.getElementById("video");
    video.style.transform = "scale(" + currentZoom + ")";
    video.style.transformOrigin = "center center";

    document.getElementById("zoomValue").innerText =
        currentZoom.toFixed(1) + "x";
}


function fullscreenVideo() {

    const frame = document.getElementById("videoFrame");

    if (frame.requestFullscreen) {
        frame.requestFullscreen();
    }

}

</script>

</body>
</html>
